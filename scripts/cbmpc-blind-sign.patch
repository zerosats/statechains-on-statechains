+error_t sign_blind(job_2p_t& job, buf_t& sid, const key_t& key, const mem_t msg, const mem_t tau, buf_t& sig) {
+  sig.free();
+  error_t rv = UNINITIALIZED_ERROR;
+  const mod_t& q = key.curve.order();
+  bn_t t;
+  if (job.is_p1()) {
+    if (tau.size != key.curve.size()) return coinbase::error(E_BADARG, "ecdsa_2p: blind tau size");
+    t = bn_t::from_bin(tau);
+    if (t >= q.value()) return coinbase::error(E_BADARG, "ecdsa_2p: blind tau out of range");
+  } else if (msg.size != 0 || tau.size != 0) {
+    return coinbase::error(E_BADARG, "ecdsa_2p: P2 must not receive the blind message or tau");
+  }
+  std::vector<mem_t> msgs(1, msg);
+  std::vector<buf_t> sigs;
+  if (rv = sign_batch_impl(job, sid, key, msgs, SIGN_MODE_DEFAULT, sigs, &t)) return rv;
